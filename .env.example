#LLM对话模型配置
API_KEY=默认使用通义千问,apikey通过百炼模型平台获取
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-max
#RAG Embedding配置
# EMBEDDING_PROVIDER: auto=填了EMBEDDING_API_KEY就用在线，否则用本地内置模型 / local=本地离线 / api=在线 / off=关闭
EMBEDDING_PROVIDER=auto
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
# RAG 检索相关度阈值（余弦距离，越小越严格）。留空则 api 后端用 0.6、本地后端用 0.75
RAG_MAX_DISTANCE=
#闲鱼接入
COOKIES_STR=your_cookies_here
TOGGLE_KEYWORDS=。
SIMULATE_HUMAN_TYPING=False
#其他配置
CONTROL_POLL_INTERVAL=10
LOG_LEVEL=INFO
LOG_DIR=data/logs
CHAT_DB_PATH=data/chat_history.db
